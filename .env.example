# Copy to `.env` to override the defaults. Every variable is optional.
# The values below are the PUBLIC demo credentials documented by the sandbox
# sites themselves (saucedemo.com and restful-booker.herokuapp.com). They are
# not secrets. In a real project, inject credentials through CI secrets.

# UI target (SauceDemo)
SAUCE_BASE_URL=https://www.saucedemo.com
SAUCE_PASSWORD=secret_sauce

# API target (Restful Booker)
BOOKER_BASE_URL=https://restful-booker.herokuapp.com
BOOKER_USERNAME=admin
BOOKER_PASSWORD=password123
